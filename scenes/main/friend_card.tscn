[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main/friend_card.gd" id="1_card"]

[sub_resource type="StyleBoxFlat" id="card_style"]
content_margin_left = 3.0
content_margin_top = 3.0
content_margin_right = 3.0
content_margin_bottom = 3.0
bg_color = Color(0.93, 0.94, 0.96, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.25, 0.32, 0.42, 1)

[sub_resource type="StyleBoxFlat" id="bar_bg"]
bg_color = Color(0.75, 0.77, 0.82, 1)

[sub_resource type="StyleBoxFlat" id="mood_fill"]
bg_color = Color(0.62, 0.58, 0.9, 1)

[sub_resource type="StyleBoxFlat" id="connection_fill"]
bg_color = Color(0.2, 0.67, 0.93, 1)

[sub_resource type="StyleBoxFlat" id="sb_fill"]
bg_color = Color(0.22, 0.55, 0.3, 1)

[node name="FriendCard" type="PanelContainer"]
theme_override_styles/panel = SubResource("card_style")
script = ExtResource("1_card")

[node name="HBoxContainer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Identity" type="VBoxContainer" parent="HBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Portrait" type="TextureRect" parent="HBoxContainer/Identity"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="HBoxContainer/Identity"]
layout_mode = 2
theme_override_colors/font_color = Color(0.1, 0.1, 0.15, 1)
theme_override_font_sizes/font_size = 6
horizontal_alignment = 1
text = "Name"

[node name="Stats" type="VBoxContainer" parent="HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="MoodLabel" type="Label" parent="HBoxContainer/Stats"]
layout_mode = 2
theme_override_colors/font_color = Color(0.1, 0.1, 0.15, 1)
theme_override_font_sizes/font_size = 6
text = "Mood"

[node name="MoodBar" type="ProgressBar" parent="HBoxContainer/Stats"]
custom_minimum_size = Vector2(0, 3)
layout_mode = 2
theme_override_styles/background = SubResource("bar_bg")
theme_override_styles/fill = SubResource("mood_fill")
show_percentage = false

[node name="ConnectionLabel" type="Label" parent="HBoxContainer/Stats"]
layout_mode = 2
